{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "Gantry Crane Sandbox",
    "version": "0.1.0"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "identifier": "com.qntology.gantry-crane-sandbox",
      "icon": ["icons/icon.png"],
      "targets": "all"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Gantry Crane Sandbox",
        "width": 1360,
        "height": 880,
        "resizable": true,
        "center": true
      }
    ]
  }
}
